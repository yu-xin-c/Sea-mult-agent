# Copy this file to backend.env and fill in your values.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen3-coder-plus
SANDBOX_URL=http://localhost:8082
OPEN_SANDBOX_URL=http://localhost:8081
ENABLE_OPENSANDBOX_FALLBACK=false
# Optional: use a prebuilt runtime image for repeatable paper smoke tests.
SANDBOX_DEFAULT_IMAGE=python:3.9-bullseye

# Runtime persistence and governance
PLAN_STORE_PATH=./data/plans.json
PLAN_MAX_TASK_ATTEMPTS=100
PLAN_MAX_DURATION_SECONDS=2100
REQUIRE_PLAN_APPROVAL=false

# API boundary. Keep API_AUTH_TOKEN empty only for trusted local development.
API_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PDF_PROXY_MAX_MB=32
UPLOAD_ROOT=./data/uploads
UPLOAD_MAX_MB=32

# Internal sandbox authentication and container policy
SANDBOX_API_TOKEN=replace-with-a-random-internal-token
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK_MODE=bridge
SANDBOX_WORKSPACE_ROOTS=/tmp
# Optional comma-separated image prefixes, for example: python:3.9,registry.example/research/
SANDBOX_IMAGE_ALLOWLIST=
SANDBOX_CONTAINER_USER=
SANDBOX_READ_ONLY_ROOT=false

# Model output is omitted from process logs by default.
LOG_MODEL_OUTPUT=false
