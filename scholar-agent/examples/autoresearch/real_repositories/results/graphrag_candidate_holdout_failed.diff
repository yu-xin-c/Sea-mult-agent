+def _has_non_string_keys(data: Any, _seen: set[int] | None = None) -> bool:
+    """Return True if any mapping key in the nested structure is not a string."""
+    if _seen is None:
+        _seen = set()
+    if id(data) in _seen:
+        return False
+    _seen.add(id(data))
+
+    if isinstance(data, dict):
+        for key, value in data.items():
+            if not isinstance(key, str):
+                return True
+            if _has_non_string_keys(value, _seen):
+                return True
+    elif isinstance(data, (list, tuple, set, frozenset)):
+        for item in data:
+            if _has_non_string_keys(item, _seen):
+                return True
+    return False
+
